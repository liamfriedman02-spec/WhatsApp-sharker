# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/sharker-bot.db

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Leave the token/phone id empty to run in dry-run mode (messages are logged, not sent).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DRY_RUN=false
# Only for `npm run templates:export -- --submit`
WHATSAPP_WABA_ID=

# ── Claude (free-text support assistant) ─────────────────────────────────────
# Without a key, free text is answered by keyword search over the knowledge base.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
CLAUDE_REFUSAL_FALLBACK=true
AI_ASSISTANT_ENABLED=true

# ── Sharker platform ─────────────────────────────────────────────────────────
# Leave empty to use the built-in demo Bosses (development only). Contract: docs/platform-api.md
SHARKER_API_BASE_URL=
SHARKER_API_KEY=
# HMAC secret for POST /webhooks/sharker (X-Sharker-Signature: sha256=<hex>)
SHARKER_WEBHOOK_SECRET=
# Boss Hub base URL used for every CTA button
BOSS_HUB_URL=https://hub.sharker.example
# Demo mode only (SHARKER_API_BASE_URL empty): chat as a demo Boss from your own WhatsApp.
# Your number in international format without + or leading 0, e.g. 972501234567
DEMO_BOSS_PHONE=
# boss_ana (new Boss) | boss_bruno (Agent without socials) | boss_carla (growing) | boss_diego (slowing down)
DEMO_BOSS_ID=boss_ana

# ── Human support ────────────────────────────────────────────────────────────
# Optional: support events (handoff opened / message / closed) are POSTed here as JSON.
SUPPORT_WEBHOOK_URL=
SUPPORT_HOURS=Mon–Fri, 9:00–18:00
HANDOFF_TIMEOUT_HOURS=24

# ── Admin API (Bearer token for /admin/*) ────────────────────────────────────
ADMIN_API_KEY=

# ── Retention engine ─────────────────────────────────────────────────────────
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
DEFAULT_TIMEZONE=UTC
QUIET_HOURS_START=21
QUIET_HOURS_END=9
# Hard caps per rolling 24h: all proactive messages / reminders + summaries
MAX_NUDGES_PER_DAY=2
MAX_REMINDERS_PER_DAY=1
