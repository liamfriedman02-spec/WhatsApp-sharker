{
  "name": "sharker-boss-whatsapp-bot",
  "version": "0.1.0",
  "description": "WhatsApp assistant for Sharker Bosses: education, support, retention and AI Marketing Agent activation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "simulate": "tsx --disable-warning=ExperimentalWarning scripts/simulate.ts",
    "templates:export": "tsx scripts/export-templates.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamfriedman02-spec/WhatsApp-sharker.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
